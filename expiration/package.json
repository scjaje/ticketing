{
  "name": "expiration",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --legacy-watch -e ts --exec tsx src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --no-cache",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "setupFiles": [
      "./src/test/env.ts"
    ],
    "setupFilesAfterEnv": [
      "./src/test/setup.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@scott-tickets/common": "^1.1.26",
    "@types/bull": "^3.15.9",
    "bull": "^4.16.5",
    "node-nats-streaming": "^0.3.2",
    "nodemon": "^3.1.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
