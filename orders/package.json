    "@types/mongoose": "^5.11.96",
    "body-parser": "^2.3.0",
    "cookie-session": "^2.1.1",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.1",
    "mongoose-update-if-current": "^1.4.0",
