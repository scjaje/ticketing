  "main": "index.js",
  "scripts": {
    "start": "nodemon --legacy-watch -e ts --exec tsx src/index.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --no-cache"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
